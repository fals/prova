{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "description": "One observation in a run's ordered event stream.",
  "type": "object",
  "properties": {
    "run": {
      "type": "string"
    },
    "seq": {
      "description": "Monotonic per run, starting at 1.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "ts_ms": {
      "description": "Unix time in milliseconds.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "v": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "run_started"
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "pid"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "test_started"
        },
        "test": {
          "$ref": "#/$defs/TestKey"
        }
      },
      "required": [
        "kind",
        "test"
      ]
    },
    {
      "type": "object",
      "properties": {
        "budget_from": {
          "description": "Where the budget came from, so the report can say (round 7).",
          "$ref": "#/$defs/BudgetFrom",
          "default": "runner"
        },
        "budget_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "elapsed_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "test_slow"
        },
        "test": {
          "$ref": "#/$defs/TestKey"
        }
      },
      "required": [
        "kind",
        "test",
        "elapsed_ms",
        "budget_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "test_finished"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "passed_in_iteration": {
          "description": "This execution passed, but the outcome recorded is the failure\nof an earlier iteration of the same run, which stands (`go test\n-count=N`: repeats are not retries, ADR 0029 section 2). History\nreads it as a pass within a failed run: flaky evidence.",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/Level"
        },
        "subtest": {
          "description": "A result nested in another test that reports its own (Go's\n`TestX/case`, pytest's subtests): counted apart from tests.",
          "type": "boolean"
        },
        "test": {
          "$ref": "#/$defs/TestKey"
        }
      },
      "required": [
        "kind",
        "test",
        "attempt",
        "outcome",
        "source"
      ]
    },
    {
      "description": "A live result whose name was ambiguous (VSTest's console names\nNUnit and MSTest tests by bare method) replaced by the result file's\nqualified one: `by` counts and keeps the history, `test` does not.",
      "type": "object",
      "properties": {
        "by": {
          "$ref": "#/$defs/TestKey"
        },
        "kind": {
          "type": "string",
          "const": "test_superseded"
        },
        "test": {
          "$ref": "#/$defs/TestKey"
        }
      },
      "required": [
        "kind",
        "test",
        "by"
      ]
    },
    {
      "type": "object",
      "properties": {
        "basis": {
          "$ref": "#/$defs/StallBasis"
        },
        "idle_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "run_stalled"
        }
      },
      "required": [
        "kind",
        "idle_ms",
        "basis"
      ]
    },
    {
      "description": "Something the agent should know about how much prova could see.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "run_note"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "description": "What the framework's own summary counted (ADR 0018), shown next to\nthe tests prova saw individually so the counts never contradict.",
      "type": "object",
      "properties": {
        "failed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "const": "run_totals"
        },
        "tests": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "kind",
        "tests",
        "failed"
      ]
    },
    {
      "description": "The run passed but verified little (ADR 0017): no test observed,\nevery test skipped, tests missing since the last pass, or error\noutput outside any test. A run with a warning is not `verified`.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "run_warning"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "description": "What a test used, when prova could attribute it (ADR 0025): its own\nprocess and descendants, or the run's group while it was the only\ntest running. The size follows from processes and network only.",
      "type": "object",
      "properties": {
        "attempt": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "evidence": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "test_size"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "test": {
          "$ref": "#/$defs/TestKey"
        }
      },
      "required": [
        "kind",
        "test",
        "attempt",
        "size",
        "evidence"
      ]
    },
    {
      "description": "What the whole command used (ADR 0025): the upper bound for tests\nprova could not attribute.",
      "type": "object",
      "properties": {
        "evidence": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "run_size"
        },
        "size": {
          "$ref": "#/$defs/Size"
        }
      },
      "required": [
        "kind",
        "size",
        "evidence"
      ]
    },
    {
      "type": "object",
      "properties": {
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int32"
        },
        "kind": {
          "type": "string",
          "const": "run_finished"
        },
        "leaked": {
          "description": "Process ids still alive in the run's process group after it ended.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/Status"
        }
      },
      "required": [
        "kind",
        "status"
      ]
    }
  ],
  "required": [
    "v",
    "run",
    "seq",
    "ts_ms"
  ],
  "$defs": {
    "BudgetFrom": {
      "description": "Origin of a slow-test budget.",
      "oneOf": [
        {
          "description": "The test runner's own warning (libtest's 60 s, nextest's SLOW).",
          "type": "string",
          "const": "runner"
        },
        {
          "description": "Three times the test's usual duration (p95 of its history).",
          "type": "string",
          "const": "history"
        },
        {
          "description": "The suite's size default: the test has no history yet.",
          "type": "string",
          "const": "default"
        }
      ]
    },
    "Level": {
      "description": "Fidelity ladder (ADR 0013). Ordered: higher knows more.",
      "oneOf": [
        {
          "description": "Exit code, output and process tree only.",
          "type": "string",
          "const": "opaque"
        },
        {
          "description": "Result files (JUnit XML, TRX) written during the run.",
          "type": "string",
          "const": "result_files"
        },
        {
          "description": "Known framework lines recognised in live output.",
          "type": "string",
          "const": "recognized"
        },
        {
          "description": "The framework's own structured stream.",
          "type": "string",
          "const": "native"
        }
      ]
    },
    "Outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "skipped",
        "errored"
      ]
    },
    "Size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "StallBasis": {
      "description": "What a stall was detected on (ADR 0004, 0013).",
      "oneOf": [
        {
          "description": "No CPU time, output or new processes in the process tree.",
          "type": "string",
          "const": "process_tree"
        },
        {
          "description": "No structured test event.",
          "type": "string",
          "const": "test_events"
        }
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "created",
        "running",
        "finished",
        "cancelled",
        "aborted"
      ]
    },
    "TestKey": {
      "description": "Identifies a test inside a suite, as reported by the framework.",
      "type": "object",
      "properties": {
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Enclosing suites or classes, outermost first.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name"
      ]
    }
  }
}
